[{"sha":"f41117c7876a12afdaf9b043cb618039a52838db","node_id":"C_kwDOTjjo9NoAKGY0MTExN2M3ODc2YTEyYWZkYWY5YjA0M2NiNjE4MDM5YTUyODM4ZGI","commit":{"author":{"name":"Dan Brewster","email":"dnbrwstr@gmail.com","date":"2026-07-25T22:49:25Z"},"committer":{"name":"Dan Brewster","email":"dnbrwstr@gmail.com","date":"2026-07-25T22:49:25Z"},"message":"add tompkins-audio-search example\n\na searchable, multimodal memory of the tompkins square park audio archive:\nask for words, weather, city sounds or bird calls, then listen at the moment\nthe archive remembers.\n\none fold KeyedStream carries every record type into a 12-way fan-out, so a\nsingle upsert atomically updates the acoustic vector index, transcript\npostings and embeddings, bird labels, the per-stream timeline, the species\nvocabulary and the coverage views -- and one retraction removes a record from\nall of them. anny backs three typed hnsw indexes (clap 512, ese 512, birdnet\n1024); ese embeds transcripts inside the pipeline, which retraction requires\nsince it must be a pure function of the text.\n\ninference stays outside the store: python workers stage checksummed batches\nand hand them to the single store owner for a short commit.\n\n92 tests.","tree":{"sha":"9fea3863772adcd0672896f76454133494b7be92","url":"https://api.github.com/repos/flowercomputers/bogkit/git/trees/9fea3863772adcd0672896f76454133494b7be92"},"url":"https://api.github.com/repos/flowercomputers/bogkit/git/commits/f41117c7876a12afdaf9b043cb618039a52838db","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/flowercomputers/bogkit/commits/f41117c7876a12afdaf9b043cb618039a52838db","html_url":"https://github.com/flowercomputers/bogkit/commit/f41117c7876a12afdaf9b043cb618039a52838db","comments_url":"https://api.github.com/repos/flowercomputers/bogkit/commits/f41117c7876a12afdaf9b043cb618039a52838db/comments","author":{"login":"dnbrwstr","id":3572