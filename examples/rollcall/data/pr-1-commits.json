_url":"https://github.com/flowercomputers/bogkit/commit/cf66313a521fcd26e62fc58bbc0a7930e5a5f180"}]},{"sha":"a808ce7c25fc0f42ef7e447ee41b24d7003f21d4","node_id":"C_kwDOTWXhVNoAKGE4MDhjZTdjMjVmYzBmNDJlZjdlNDQ3ZWU0MWIyNGQ3MDAzZjIxZDQ","commit":{"author":{"name":"rcrdlbl","email":"bluh@outlook.com","date":"2026-07-12T20:05:50Z"},"committer":{"name":"rcrdlbl","email":"bluh@outlook.com","date":"2026-07-12T20:05:50Z"},"message":"mmo-cs: add Dockerfile for zero-spend hosting\n\nTwo-stage build (rust:1-bookworm -> debian-slim) so mmo-cs can deploy to\nNorthflank/Koyeb's free tiers for the hackathon demo. Repo root is the\nbuild context since fold is a sibling path dep.\n\nCo-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>","tree":{"sha":"2bb62417d067aad45a435f965c5743446b058408","url":"https://api.github.com/repos/flowercomputers/bogkit/git/trees/2bb62417d067aad45a435f965c5743446b058408"},"url":"https://api.github.com/repos/flowercomputers/bogkit/git/commits/a808ce7c25fc0f42ef7e447ee41b24d7003f21d4","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN SSH SIGNATURE-----\nU1NIU0lHAAAAAQAAADMAAAALc3NoLWVkMjU1MTkAAAAge67vLMJpFKoylT1GXAp6jFhklz\nSETagmDKa9bm63+OoAAAADZ2l0AAAAAAAAAAZzaGE1MTIAAABTAAAAC3NzaC1lZDI1NTE5\nAAAAQJUFehug34O0NnIr5os42t2Ho2jUD1NOX10nj7rMS56tf0h05M4mxdRzDMeBQOlH4a\nWTQ6lhCmufZkdlPG5pEwA=\n-----END SSH SIGNATURE-----","payload":"tree 2bb62417d067aad45a435f965c5743446b058408\nparent cf66313a521fcd26e62fc58bbc0a7930e5a5f180\nauthor rcrdlbl <bluh@outlook.com> 1783886750 -0400\ncommitter rcrdlbl <bluh@outlook.com> 1783886750 -0400\n\nmmo-cs: add Dockerfile for zero-spend hosting\n\nTwo-stage build (rust:1-bookworm -> debian-slim) so mmo-cs can deploy to\nNorthflank/Koyeb's free tiers for the hackathon demo. Repo root is the\nbuild context since fold is a sibling path dep.\n\nCo-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>\n","verified_at":"2026-07-12T20:05:57Z"}},"url":"https://api.github.com/repos/flowercomputers/bogkit/commits/a808ce7c25fc0f42ef7e447ee41b24d7003f21d4","html_url":"https://github.com/flowercomputers/bogkit/commit/a808ce7c25fc0f42ef7e447ee41b24d7003f21d4","comments_url":"https://api.github.com/repos/flowercomputers/bogkit/commits/a808ce7c25fc0f42ef7e447ee41b24d7003f21d4/comments","author":{"login":"rcrdlbl","id":40729534,"node_id":"MDQ6VXNlcjQwNzI5NTM0","avatar_url":"https://avatars.githubusercontent.com/u/40729534?v=4","gravatar_id":"","url":"https://api.github.com/users/rcrdlbl","html_url":"https://github.com/rcrdlbl","followers_url":"https://api.github.com/users/rcrdlbl/followers","following_url":"https://api.github.com/users/rcrdlbl/following{/other_user}","gists_url":"https://api.github.com/users/rcrdlbl/gists{/gist_id}","starred_url":"https://api.github.com/users/rcrdlbl/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rcrdlbl/subscriptions","organizations_url":"https://api.github.com/users/rcrdlbl/orgs","repos_url":"https://api.github.com/users/rcrdlbl/repos","events_url":"https://api.github.com/users/rcrdlbl/events{/privacy}","received_events_url":"https://api.github.com/users/rcrdlbl/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"rcrdlbl","id":40729534,"node_id":"MDQ6VXNlcjQwNzI5NTM0","avatar_url":"https://avatars.githubusercontent.com/u/40729534?v=4","gravatar_id":"","url":"https://api.github.com/users/rcrdlbl","html_url":"https://github.com/rcrdlbl","followers_url":"https://api.github.com/users/rcrdlbl/followers","following_url":"https://api.github.com/users/rcrdlbl/following{/other_user}","gists_url":"https://api.github.com/users/rcrdlbl/gists{/gist_id}","starred_url":"https://api.github.com/users/rcrdlbl/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rcrdlbl/subscriptions","organizations_url":"https://api.github.com/users/rcrdlbl/orgs","repos_url":"https://api.github.com/users/rcrdlbl/repos","events_url":"https://api.github.com/users/rcrdlbl/events{/privacy}","received_events_url":"https://api.github.com/users/rcrdlbl/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"cf66313a521fcd26e62fc58bbc0a7930e5a5f180","url":"https://api.github.com/repos/flowercomputers/bogkit/commits/cf66313a521fcd26e62fc58bbc0a7930e5a5f180","html_url":"https://github.com/flowercomputers/bogkit/commit/cf66313a521fcd26e62fc58bbc0a7930e5a5f180"}]},{"sha":"ffdb3998b0776f48808da9025591c30fb9465afb","node_id":"C_kwDOTWXhVNoAKGZmZGIzOTk4YjA3NzZmNDg4MDhkYTkwMjU1OTFjMzBmYjk0NjVhZmI","commit":{"author":{"name":"rcrdlbl","email":"bluh@outlook.com","date":"2026-07-12T20:05:55Z"},"committer":{"name":"rcrdlbl","email":"bluh@outlook.com","date":"2026-07-12T20:05:55Z"},"message":"mmo-cs: replace CLI-driven auto-start with a search + duration menu and lobby\n\nBattles used to auto-start with a randomly (or MMO_PARK-env-pinned) chosen\npark and a fixed duration the instant a slot opened, with no client input.\nNow each battle begins unconfigured: the client gets a menu to search the\npark catalog by name and pick a match length, and only once someone submits\nconfigure_battle does the existing join/start lobby appear.\n\nServer-side, this splits battle::run into two phases per battle — an\n\"awaiting configuration\" phase that only needs the roster stream (which\ndoesn't depend on a park), and the existing match phase, which now defers\nbuilding the presence stream (whose aggregate closure bakes in the chosen\npark's bbox) until a park is actually chosen. Battle.park/duration_ms\nbecome Option, first configure_battle wins, and MMO_BATTLE_DURATION_SECS\nstill works as a hard override for local testing.\n\nClient-side, the parks catalog is embedded into the index page (no extra\nround trip) for a simple type-to-filter search; selecting a result and a\nduration and clicking \"create match\" sends configure_battle. The existing\nlastBattleId reset means every subsequent match goes through the same\nmenu -> lobby cycle, not just the first.\n\nVerified end-to-end: a scripted websocket client exercising configure_battle\nvalidation/locking and a Playwright-driven two-browser run through\nsearch -> select -> duration -> create match -> join -> start -> win,\nthen confirming the next battle re-shows the menu.\n\nCo-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>","tree":{"sha":"6c00cb656a88fb85c5893efeb0b3b90304cb2c8b","url":"https://api.github.com/repos/flowercomputers/bogkit/git/trees/6c00cb656a88fb85c5893efeb0b3b90304cb2c8b"},"url":"https://api.github.com/repos/flowercomputers/bogkit/git/commits/ffdb3998b0776f48808da9025591c30fb9465afb","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN SSH SIGNATURE-----\nU1NIU0lHAAAAAQAAADMAAAALc3NoLWVkMjU1MTkAAAAge67vLMJpFKoylT1GXAp6jFhklz\nSETagmDKa9bm63+OoAAAADZ2l0AAAAAAAAAAZzaGE1MTIAAABTAAAAC3NzaC1lZDI1NTE5\nAAAAQGnAtgb9y4jNgJ1yKdk38QQgeEjYAc0bij1/Tn6yBIpr/+TaEmxkgtWkfTuNIV9/Z0\nQpP3eHeAwmTgWOaNmEzwA=\n-----END SSH SIGNATURE-----","payload":"tree 6c00cb656a88fb85c5893efeb0b3b90304cb2c8b\nparent a7713783e4bde613c91fce1ecce851a5a374af2d\nauthor rcrdlbl <bluh@outlook.com> 1783886755 -0400\ncommitter rcrdlbl <bluh@outlook.com> 1783886755 -0400\n\nmmo-cs: replace CLI-driven auto-start with a search + duration menu and lobby\n\nBattles used to auto-start with a randomly (or MMO_PARK-env-pinned) chosen\npark and a fixed duration the instant a slot opened, with no client input.\nNow each battle begins unconfigured: the client gets a menu to search the\npark catalog by name and pick a match length, and only once someone submits\nconfigure_battle does the existing join/start lobby appear.\n\nServer-side, this splits battle::run into two phases per battle — an\n\"awaiting configuration\" phase that only needs the roster stream (which\ndoesn't depend on a park), and the existing match phase, which now defers\nbuilding the presence stream (whose aggregate closure bakes in the chosen\npark's bbox) until a park is actually chosen. Battle.park/duration_ms\nbecome Option, first configure_battle wins, and MMO_BATTLE_DURATION_SECS\nstill works as a hard override for local testing.\n\nClient-side, the parks catalog is embedded into the index page (no extra\nround trip) for a simple type-to-filter search; selecting a result and a\nduration and clicking \"create match\" sends configure_battle. The existing\nlastBattleId reset means every subsequent match goes through the same\nmenu -> lobby cycle, not just the first.\n\nVerified end-to-end: a scripted websocket client exercising configure_battle\nvalidation/locking and a Playwright-driven two-browser run through\nsearch -> select -> duration -> create match -> join -> start -> win,\nthen confirming the next battle re-shows the menu.\n\nCo-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>\n","verified_at":"2026-07-12T20:06:07Z"}},"url":"https://api.github.com/repos/flowercomputers/bogkit/commits/ffdb3998b0776f48808da9025591c30fb9465afb","html_url":"https://github.com/flowercomputers/bogkit/commit/ffdb3998b0776f48808da9025591c30fb9465afb","comments_url":"https://api.github.com/repos/flowercomputers/bogkit/commits/ffdb3998b0776f48808da9025591c30fb9465afb/comments","author":{"login":"rcrdlbl","id":40729534,"node_id":"MDQ6VXNlcjQwNzI5NTM0","avatar_url":"https://avatars.githubusercontent.com/u/40729534?v=4","gravatar_id":"","url":"https://api.github.com/users/rcrdlbl","html_url":"https://github.com/rcrdlbl","followers_url":"https://api.github.com/users/rcrdlbl/followers","following_url":"https://api.github.com/users/rcrdlbl/following{/other_user}","gists_url":"https://api.github.com/users/rcrdlbl/gists{/gist_id}","starred_url":"https://api.github.com/users/rcrdlbl/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/rcrdlbl/subscriptions","organizations_url":"https://api.github.com/users/rcrdlbl/orgs","repos_url":"https://api.github.com/users/rcrdlbl/repos","events_url":"https://api.github.com/user